{
  "name": "form-engine",
  "version": "0.1.0",
  "description": "React form generation library — conditional display, multi-step pagination, OTP, file upload, repeat groups",
  "author": "Sublime World",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "zod": ">=3.0.0",
    "zustand": ">=4.0.0",
    "lucide-react": ">=0.300.0",
    "react-hot-toast": ">=2.0.0",
    "@tiptap/react": ">=2.0.0",
    "@tiptap/starter-kit": ">=2.0.0",
    "@tiptap/extension-image": ">=2.0.0",
    "@tiptap/extension-link": ">=2.0.0",
    "@tiptap/extension-placeholder": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/react": { "optional": true },
    "@tiptap/starter-kit": { "optional": true },
    "@tiptap/extension-image": { "optional": true },
    "@tiptap/extension-link": { "optional": true },
    "@tiptap/extension-placeholder": { "optional": true }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.0.0",
    "classnames": "^2.3.0",
    "gsap": "^3.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "form",
    "form-builder",
    "form-generator",
    "form-engine",
    "typescript",
    "zod",
    "react-hook-form"
  ]
}
